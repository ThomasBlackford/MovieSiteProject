// SQLite for the prototype. To move to Postgres: change provider to
// "postgresql" and point DATABASE_URL at Neon.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  displayName String
  bio         String    @default("")
  createdAt   DateTime  @default(now())
  ratings     Rating[]
  posts       Post[]
  comments    Comment[]
  likes       Like[]
  lists       List[]
  following   Follow[]  @relation("follower")
  followers   Follow[]  @relation("following")
}

model Movie {
  id        String    @id @default(cuid())
  tmdbId    Int?      @unique
  title     String
  year      Int
  runtime   Int
  genres    String
  overview  String
  featured  Boolean   @default(false)
  ratings   Rating[]
  comments  Comment[]
  listItems ListItem[]
}

// One rating per user per movie. score is 1..10 (half-stars: 7 = 3.5 stars).
model Rating {
  id        String   @id @default(cuid())
  score     Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   String
  likes     Like[]

  @@unique([userId, movieId])
}

model Post {
  id        String    @id @default(cuid())
  title     String
  body      String
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  comments  Comment[]
  likes     Like[]
}

// A comment belongs to either a movie or a post. parentId enables threads.
model Comment {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  movie     Movie?    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   String?
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  parent    Comment?  @relation("thread", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String?
  replies   Comment[] @relation("thread")
}

// A like targets either a rating (review) or a post.
model Like {
  id       String  @id @default(cuid())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  rating   Rating? @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  ratingId String?
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String?

  @@unique([userId, ratingId])
  @@unique([userId, postId])
}

model Follow {
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String

  @@id([followerId, followingId])
}

// isWatchlist marks each user's built-in watchlist.
model List {
  id          String     @id @default(cuid())
  name        String
  isWatchlist Boolean    @default(false)
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  items       ListItem[]
}

model ListItem {
  list    List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId  String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId String
  addedAt DateTime @default(now())

  @@id([listId, movieId])
}
